        if (time === undefined || time < 3000) {
            time = 3000;
        }
        $('#Testin-globalErrorTipsMsg').text(msg);
        $('#Testin-globalErrorTips').show();
        setTimeout(function() {
            $('#Testin-globalErrorTips').hide();
            $('#Testin-globalErrorTipsMsg').text('');
            if (typeof(callback) === 'function') {
                callback();
            }
        }, time);
